# macOS
.DS_Store

# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
build/
dist/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Virtual environments
.venv/
venv/
env/

# Editor / IDE
.vscode/
.idea/
*.swp
*.swo

# User-upload sessions: rebuilt with `ceiling-rcp-init`, never committed.
sessions/

# CLI debug outputs
out_*/

# Segmentation lab outputs
debug_out/

# Height-map artefacts inside sessions or anywhere else
*.npy

# Scan inputs are large (~1.5 GB) and live outside source control.
# Track which scans you've used in README or docs/, not the raw bytes.
Scan data/

# Claude tooling state
.claude/

# Local-only logs
*.log

# Experiment results — regenerated each run; truth is in debug/ground_truth/
debug/results*/

# SAM 3 segmentation — per-keyframe outputs are bulky (~250 MB) and
# regenerated via run_runpod.py / run_sam3.py. Live in a sibling
# location on disk; commit only the scripts and READMEs here.
experiments/segmentation_sam3*/results/
experiments/segmentation_sam3*/results_sample/
experiments/segmentation_sam3*/working_set/
experiments/segmentation_sam3*/roboflow_compare/
experiments/segmentation_sam3*/index.html

# Per-experiment projection outputs — regenerated by project_masks.py
experiments/segmentation_projection/outputs/
